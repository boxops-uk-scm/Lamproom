# Lamproom server configuration. Copy to .env and fill in the GitHub App.
#
#   cp .env.example .env
#
# .env is sourced by the Makefile, so shell quoting rules apply and it
# overrides variables already in your environment. Never commit it.

# --- Sign-in: required in production -----------------------------------------
# A GitHub App (Settings > Developer settings), with:
#   callback URL   http://localhost:4411/auth/github/callback
#   Enable Device Flow   ticked (terminals sign in with the device flow)
#   permissions    Metadata: read
#   installed on   the repositories you want to track
# An OAuth App works too, with LAMPROOM_GITHUB_SCOPE="read:user repo".
LAMPROOM_GITHUB_CLIENT_ID=
LAMPROOM_GITHUB_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------
# Cookie signing and token encryption. Generated into the data directory if
# unset; set it explicitly to keep sessions alive across a data wipe.
# Generate one with: openssl rand -hex 32
#LAMPROOM_SECRET=

# Data directory: holds lamproom.db and the signing secret. Default ~/.lamproom
#LAMPROOM_DATA=

# Listen address. Defaults: port 4411, host 127.0.0.1.
#LAMPROOM_PORT=4411
#LAMPROOM_HOST=127.0.0.1

# How the browser reaches the server, if not http://localhost:<port>. Register
# this host's /auth/github/callback with the app as well.
#LAMPROOM_PUBLIC_URL=

# Postgres instead of SQLite (the pg package must be installed; untested).
#LAMPROOM_DATABASE_URL=postgres://...

# --- Clients: the CLI and the Claude Code plugin -----------------------------
# Which server to talk to. Default http://localhost:4411
#LAMPROOM_SERVER=

# An API token, instead of the one `make login` writes to
# ~/.config/lamproom/config.json.
#LAMPROOM_TOKEN=

# Pin the project instead of resolving it from the git remote.
#LAMPROOM_PROJECT=owner/name

# The agent's label in the log.
#LAMPROOM_AGENT=

# Auto-tracking of ordinary chat turns: 0 turns it off; the model is a Haiku.
#LAMPROOM_AUTOTRACK=1
#LAMPROOM_TRACKER_MODEL=

# --- Development only --------------------------------------------------------
# Signs every request in as this login with no GitHub at all. `make serve`
# refuses to start with this set; use `make dev-serve DEV_USER=tom` instead.
#LAMPROOM_DEV_USER=
