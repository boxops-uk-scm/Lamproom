{
  "name": "coalface",
  "private": true,
  "version": "0.1.0",
  "description": "Hypergraph workflow tracker for agentic development",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @coalface/core test",
    "typecheck": "pnpm -r typecheck",
    "dev:ui": "pnpm --filter @coalface/ui dev",
    "serve": "node packages/cli/dist/coalface.js serve",
    "seed": "pnpm --filter @coalface/cli seed"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
