{
  "name": "@coalface/cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "coalface CLI: serve the live graph UI, init a repo, replay a log",
  "bin": { "coalface": "./dist/coalface.js" },
  "scripts": {
    "build": "node build.mjs",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --outfile=dist/seed.mjs --log-level=warning && node dist/seed.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@coalface/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
