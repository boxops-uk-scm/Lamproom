{
  "name": "@lamproom/ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Lamproom UI: live hypergraph and board of every seam in a project",
  "scripts": {
    "dev": "pnpm theme:build && vite",
    "build": "pnpm theme:build && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "sync-boxops": "node scripts/sync-boxops-tokens.mjs",
    "astryx": "astryx",
    "theme:build": "astryx theme build src/theme/boxopsTheme.tsx -o src/theme/boxops.css --icons-specifier ./icons"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.1",
    "@lamproom/core": "workspace:*",
    "@lexical/code": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "@xyflow/react": "^12.6.0",
    "elkjs": "^0.10.0",
    "lexical": "0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
