{
  "description": "Injects the current coal face into context at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/session-start.js"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
